html 
    head 
        title Add User Page 
        link(rel="stylesheet", href="/style.css")
    body
        main.page
            h1 Add User
            form.form-panel(action="/user/add" method="post")
                div.form-field
                    label(for="name") Name
                    input(type="text" name="name" required)
                div.form-field
                    label(for="city") City
                    input(type="text" name="city" required)
                div.form-actions
                    button(type="submit") Add user
                    a.link(href="/user") Cancel