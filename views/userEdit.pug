html
    head
        title Edit User
        link(rel="stylesheet", href="/style.css")
    body
        main.page
            h1 Edit User Page
            form.form-panel(action=`/user/${user._id}/edit` method="post")
                div.form-field
                    label(for="name") Name
                    input(type="text" name="name" value=user.name required)
                div.form-field
                    label(for="city") City
                    input(type="text" name="city" value=user.city required)
                div.form-actions
                    button(type="submit") Update User
                    a.link(href="/user") Cancel